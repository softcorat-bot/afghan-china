APP_NAME="Afghan China Offline"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:__PORT__
FRONTEND_URL=http://127.0.0.1:__PORT__/app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Local SQLite database (writable data dir, outside Program Files).
DB_CONNECTION=sqlite
DB_DATABASE=__DATA_DIR__\offline.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Offline Mode ──
OFFLINE_MODE=true
CENTRAL_URL=__CENTRAL_URL__
OFFLINE_DEVICE_ID=
OFFLINE_DEVICE_TOKEN=
OFFLINE_APP_VERSION=__APP_VERSION__
OFFLINE_AUTO_SYNC_MINUTES=0
