APP_NAME="Afghan China MIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:9000

# Extra origins the dashboard is served from, comma separated — needed for a
# hosted install, where the browser will otherwise discard the API's response
# and sign-in fails with "Network Error". localhost on any port, LAN IPs and
# the desktop app's file:// origin are already allowed by config/cors.php.
# CORS_ALLOWED_ORIGINS=https://mis.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is the development default — no server to install.
DB_CONNECTION=sqlite

# For a hosted install (cPanel and friends), switch to MySQL: comment out the
# line above, uncomment these, and fill in the values cPanel gave you. Note
# that cPanel prefixes both the database and the user with your account name,
# e.g. `myshop_acsc` / `myshop_acscuser`. See docs/DEPLOY_CPANEL.md.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=youracct_acsc
# DB_USERNAME=youracct_acsc
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Sanctum SPA auth — frontend dev server origin(s)
SANCTUM_STATEFUL_DOMAINS=localhost:9000,127.0.0.1:9000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Demo business history (sales, expenses, loyalty customers). Left unset on
# purpose: the default follows APP_ENV, so it is on locally and OFF in
# production, and invented invoices never land in a real shop's books.
# Uncomment only to load the demo history onto a production install.
# SEED_DEMO_DATA=true

# ── Automatic backups ────────────────────────────────────────────────
# A nightly backup runs at 01:00 and keeps the newest copies locally.
BACKUP_KEEP=14
# Off-site copy (strongly recommended). Name any disk from
# config/filesystems.php — e.g. s3. Leave empty to keep backups local only.
BACKUP_OFFSITE_DISK=
BACKUP_OFFSITE_PATH=afghan-china-backups
BACKUP_OFFSITE_KEEP=30
# Optionally email each backup as well (small SQLite databases only).
BACKUP_EMAIL_TO=
BACKUP_EMAIL_MAX_MB=15

# ── Offline Mode (this machine is an offline installation) ────────────
# Leave OFFLINE_MODE=false (or unset) on Central / normal installs.
# The Windows installer's .env enables these automatically.
OFFLINE_MODE=false
# Where this installation pushes/pulls when it has internet.
CENTRAL_URL=
# Device identity (or run: php artisan offline:register --code XXXX-XXXX).
OFFLINE_DEVICE_ID=
OFFLINE_DEVICE_TOKEN=
OFFLINE_APP_VERSION=1.0.0
# 0 = manual "Sync Now" only; N = also auto-sync every N minutes.
OFFLINE_AUTO_SYNC_MINUTES=0
