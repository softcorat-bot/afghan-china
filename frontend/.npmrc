# Disable pnpm supply-chain minimumReleaseAge policy for this project
minimum-release-age=0
verify-deps-before-run=false

# Network tuning for slow / flaky connections (large native-binary tarballs such
# as the rolldown / oxlint / oxfmt platform bindings). One download at a time so
# each gets full bandwidth, with long timeouts and many retries — this avoids the
# "error (23)" mid-download failures that abort `pnpm install`.
fetch-timeout=900000
fetch-retries=8
fetch-retry-factor=2
fetch-retry-maxtimeout=300000
fetch-retry-mintimeout=20000
network-concurrency=1
